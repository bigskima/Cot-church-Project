# Standard Supabase Edge runtime variables
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated exact or wildcard browser origins, e.g. https://app.example.com,https://*--preview.example.com
# Active server-only platform_web_origins rows are merged with this list at runtime.
ALLOWED_ORIGINS=
RATE_LIMIT_PEPPER=

# Values are JSON credentials kept only in Edge Function secrets.
# Database secret_reference columns contain these variable names, never their values.
STREAMING_MUX_PRIMARY=
STREAMING_MUX_WEBHOOK_PRIMARY=
STREAMING_MUX_SIGNING_PRIMARY=
AI_OPENAI_PRIMARY=
AI_GEMINI_PRIMARY=
AI_ANTHROPIC_PRIMARY=
