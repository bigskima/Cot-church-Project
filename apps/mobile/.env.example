# Required: deployment-specific Supabase Edge Functions base URL.
# Example format: https://<project-ref>.supabase.co/functions/v1
EXPO_PUBLIC_API_URL=https://<project-ref>.supabase.co/functions/v1

# Dedicated web surface for Platform Administrator invitation acceptance and operations.
EXPO_PUBLIC_PLATFORM_ADMIN_URL=https://cot-admin.vercel.app

# Optional/public client configuration. Never put private provider secrets here.
EXPO_PUBLIC_PAYMENT_PROVIDER=YOUR_CONFIGURED_PROVIDER
EXPO_PUBLIC_ORGANIZATION_ID=PUBLIC_DISCOVERY_ORGANIZATION_UUID
