{
  "expo": {
    "name": "COT",
    "slug": "church-platform",
    "owner": "0xskima",
    "scheme": "churchos",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a4c107b0-6c97-46b9-a9d0-27b2a24838d5",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#091733"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow COT to access your photos so you can choose a profile picture.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow COT to record audio that you choose to share.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#091733",
          "image": "./assets/splash.png",
          "imageWidth": 240
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cot.app"
    },
    "android": {
      "package": "com.cot.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#091733"
      },
      "splash": {
        "backgroundColor": "#091733",
        "resizeMode": "contain",
        "image": "./assets/splash.png"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/splash.png"
    },
    "extra": {
      "eas": {
        "projectId": "a4c107b0-6c97-46b9-a9d0-27b2a24838d5"
      }
    }
  }
}
